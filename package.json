{
  "name": "t2",
  "appName": "Soap2Day TV Navigation",
  "version": "2.2.0",
  "description": "Soap2Day website module with directional remote navigation for Samsung Smart TVs.",
  "packageType": "mods",
  "main": "tv-navigation.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "relay": "node service/hlsRelay.js",
    "build": "vite build",
    "preview": "vite preview",
    "prepublishOnly": "npm run build"
  },
  "author": "Zyrex",
  "keys": [
    "MediaPlayPause",
    "MediaPlay",
    "MediaPause",
    "MediaStop",
    "MediaFastForward",
    "MediaRewind",
    "MediaTrackNext",
    "MediaTrackPrevious"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/TreborNamor/t4"
  },
  "bugs": {
    "url": "https://github.com/TreborNamor/t4/issues"
  },
  "homepage": "https://github.com/TreborNamor/t4#readme",
  "keywords": [
    "tizenbrew",
    "tizen",
    "samsung",
    "tv",
    "tmdb",
    "streaming"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "lucide-static": "^1.39.0",
    "vite": "^6.2.0"
  },
  "dependencies": {
    "hls.js": "^1.7.1",
    "qrcode": "^1.5.4"
  },
  "websiteURL": "https://ww25.soap2day.day/pwa/?s2d_surface=pwa",
  "evaluateScriptOnDocumentStart": false
}
